<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ChessMultitool.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ChessMultitool"
    Shell.FlyoutBehavior="Disabled"
    Shell.TabBarBackgroundColor="#0D0D0D"
    Shell.TabBarForegroundColor="#C8963E"
    Shell.TabBarUnselectedColor="#444444"
    Shell.TabBarTitleColor="#C8963E"
    BackgroundColor="#111111"
    Title="ChessMultitool">

    <TabBar>
        <ShellContent Title="Play" Icon="BottomBarIcons/explorer.png" Route="PlayPage" ContentTemplate="{DataTemplate local:AILevelSelectionPage}" />

        <ShellContent Title="Puzzles" Icon="BottomBarIcons/puzzles.png" Route="PuzzlesPage" ContentTemplate="{DataTemplate local:PuzzlesPage}" />

        <ShellContent Title="Library" Icon="BottomBarIcons/library.png" Route="PuzzleListPage" ContentTemplate="{DataTemplate local:PuzzleListPage}" />

        <ShellContent Title="Tools" Icon="BottomBarIcons/tools.png" Route="ToolsPage" ContentTemplate="{DataTemplate local:ToolsPage}" />

        <ShellContent Title="Settings" Icon="BottomBarIcons/settings.png" Route="SettingsPage" ContentTemplate="{DataTemplate local:SettingsPage}" />
    </TabBar>
</Shell>
