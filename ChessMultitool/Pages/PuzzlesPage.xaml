<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    x:Class="ChessMultitool.PuzzlesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ChessMultitool"
    BackgroundColor="#111111"
    Shell.NavBarIsVisible="False"
    Title="Puzzles">

    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="0">

        <!-- ── Header ── -->
        <Grid Grid.Row="0" Padding="20,52,20,12" ColumnDefinitions="*,Auto,*">

            <Border Grid.Column="0"
                    BackgroundColor="#1E1E1E"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 20"
                    Padding="13,8"
                    HorizontalOptions="Start"
                    VerticalOptions="Center">
                <HorizontalStackLayout Spacing="7" VerticalOptions="Center">
                    <BoxView x:Name="SideDot"
                             WidthRequest="9" HeightRequest="9"
                             CornerRadius="4.5"
                             Color="#EEEEEE"
                             VerticalOptions="Center" />
                    <Label x:Name="TurnLabel"
                           Text="White to move"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#CCCCCC"
                           VerticalTextAlignment="Center" />
                </HorizontalStackLayout>
            </Border>

            <Label Grid.Column="1"
                   Text="PUZZLES"
                   FontSize="13"
                   FontAttributes="Bold"
                   CharacterSpacing="3"
                   TextColor="#555555"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center" />

            <HorizontalStackLayout Grid.Column="2"
                                   Spacing="8"
                                   HorizontalOptions="End"
                                   VerticalOptions="Center">
                <Border BackgroundColor="#1E1E1E"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 20"
                        Padding="13,8"
                        VerticalOptions="Center">
                    <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                        <Label Text="★" FontSize="13" TextColor="#C8963E" VerticalTextAlignment="Center" />
                        <Label x:Name="RatingLabel" Text="—" FontSize="14" FontAttributes="Bold"
                               TextColor="#CCCCCC" VerticalTextAlignment="Center" />
                    </HorizontalStackLayout>
                </Border>

                <!-- Analysis board (free move, no AI) -->
                <Border BackgroundColor="#1E1E1E"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 20"
                        Padding="11,8"
                        VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAnalysisClicked" />
                    </Border.GestureRecognizers>
                    <Label Text="🔍" FontSize="14" TextColor="#C8963E" VerticalTextAlignment="Center" />
                </Border>
            </HorizontalStackLayout>
        </Grid>

        <!-- ── Board area ── -->
        <Grid Grid.Row="1" VerticalOptions="Center" HorizontalOptions="Fill" Padding="12,0">
            <Border BackgroundColor="#0A0A0A" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="0">
                <Grid x:Name="BoardGrid" HorizontalOptions="Fill" HeightRequest="360">
                    <Image Source="{DynamicResource BoardImageSource}" Aspect="Fill"
                           InputTransparent="True" ZIndex="0" />
                    <Grid x:Name="HighlightGrid" RowSpacing="0" ColumnSpacing="0"
                          BackgroundColor="Transparent" ZIndex="1" />
                    <Grid x:Name="PieceGrid" RowSpacing="0" ColumnSpacing="0"
                          BackgroundColor="Transparent" ZIndex="2" />
                    <Grid x:Name="OverlayGrid" RowSpacing="0" ColumnSpacing="0"
                          BackgroundColor="Transparent" ZIndex="3" />
                    <Grid x:Name="PromotionContainer" IsVisible="False"
                          BackgroundColor="#CC000000" ZIndex="4" RowSpacing="0" ColumnSpacing="0">
                        <local:PromotionMenu x:Name="PromotionMenuView"
                                             HorizontalOptions="Center" VerticalOptions="Center" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ── Bottom bar: always 3 fixed buttons, no layout shift ── -->
        <Grid Grid.Row="2" Padding="16,14,16,20" ColumnDefinitions="*,*,*" ColumnSpacing="8">

            <!-- Prev move -->
            <Button x:Name="PrevMoveBtn" Grid.Column="0" Text="←" Clicked="OnPrevMoveClicked"
                    BackgroundColor="#1E1E1E" TextColor="#AAAAAA"
                    FontSize="20" CornerRadius="12" HeightRequest="48" Padding="0" />

            <!-- Next move (replay) -->
            <Button x:Name="NextMoveBtn" Grid.Column="1" Text="→" Clicked="OnNextMoveClicked"
                    BackgroundColor="#1E1E1E" TextColor="#AAAAAA"
                    FontSize="20" CornerRadius="12" HeightRequest="48" Padding="0" />

            <!-- Dynamic third button: Hint / Retry / Next — same cell, one visible at a time -->
            <Grid Grid.Column="2" HeightRequest="48">

                <!-- Hint (default) -->
                <Button x:Name="HintBtn" Text="💡" Clicked="OnHintClicked"
                        BackgroundColor="#1E1E1E" TextColor="#C8963E"
                        FontSize="20" CornerRadius="12" HeightRequest="48" Padding="0" />

                <!-- Retry (shown after a wrong attempt) -->
                <Button x:Name="RetryBtn" Text="↺" Clicked="OnRetry" IsVisible="False"
                        BackgroundColor="#EF3B3B" TextColor="White"
                        FontSize="22" CornerRadius="12" HeightRequest="48" Padding="0" />

                <!-- Next puzzle (shown once solved) -->
                <Button x:Name="NextBtn" Text="Next →" Clicked="OnNextPuzzle" IsVisible="False"
                        BackgroundColor="#1C2B1C" TextColor="#6BCB77"
                        BorderColor="#6BCB77" BorderWidth="1"
                        FontSize="13" FontAttributes="Bold"
                        CornerRadius="12" HeightRequest="48" Padding="0" />

            </Grid>
        </Grid>

    </Grid>
</ContentPage>
