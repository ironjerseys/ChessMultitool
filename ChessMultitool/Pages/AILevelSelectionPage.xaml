<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ChessMultitool.AILevelSelectionPage"
             BackgroundColor="#111111"
             Shell.NavBarIsVisible="False"
             Title="Play">

    <ScrollView>
        <VerticalStackLayout Padding="20,52,20,24" Spacing="0">

            <!-- Page title -->
            <Label Text="PLAY"
                   FontSize="11"
                   FontAttributes="Bold"
                   CharacterSpacing="3"
                   TextColor="#555555"
                   Margin="0,0,0,24" />

            <Label Text="New Game"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="#EEEEEE" />
            <Label Text="Set up your board and challenge the engine."
                   FontSize="13"
                   TextColor="#777777"
                   Margin="0,4,0,28" />

            <!-- ── Color choice ── -->
            <Label Text="YOUR COLOR"
                   FontSize="10"
                   FontAttributes="Bold"
                   CharacterSpacing="2"
                   TextColor="#444444"
                   Margin="0,0,0,12" />

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10" Margin="0,0,0,28">
                <Border x:Name="WhiteCard"
                        Grid.Column="0"
                        BackgroundColor="#1A1A1A"
                        StrokeThickness="2"
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 14"
                        Padding="0,18">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnWhiteClicked" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="8">
                        <Image Source="kingw.png" HeightRequest="46" Aspect="AspectFit" />
                        <Label Text="White"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#CCCCCC"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <Border x:Name="AlternateCard"
                        Grid.Column="1"
                        BackgroundColor="#1A1A1A"
                        StrokeThickness="2"
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 14"
                        Padding="0,18">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAlternateClicked" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="8">
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="-10">
                            <Image Source="kingw.png" HeightRequest="46" Aspect="AspectFit" />
                            <Image Source="kingb.png" HeightRequest="46" Aspect="AspectFit" />
                        </HorizontalStackLayout>
                        <Label Text="Alternate"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#CCCCCC"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <Border x:Name="BlackCard"
                        Grid.Column="2"
                        BackgroundColor="#1A1A1A"
                        StrokeThickness="2"
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 14"
                        Padding="0,18">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBlackClicked" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="8">
                        <Image Source="kingb.png" HeightRequest="46" Aspect="AspectFit" />
                        <Label Text="Black"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#CCCCCC"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- ── Opening ── -->
            <Label Text="OPENING  ·  OPTIONAL"
                   FontSize="10"
                   FontAttributes="Bold"
                   CharacterSpacing="2"
                   TextColor="#444444"
                   Margin="0,0,0,12" />

            <Border BackgroundColor="#1A1A1A"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    Padding="14,2"
                    Margin="0,0,0,10">
                <Picker x:Name="OpeningPicker"
                        Title="Any (no restriction)"
                        TextColor="#CCCCCC"
                        TitleColor="#777777"
                        SelectedIndexChanged="OnOpeningChanged" />
            </Border>

            <Border BackgroundColor="#1A1A1A"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    Padding="14,2"
                    Margin="0,0,0,36">
                <Picker x:Name="VariationPicker"
                        Title="Auto (Main Line)"
                        TextColor="#CCCCCC"
                        TitleColor="#777777"
                        SelectedIndexChanged="OnVariationChanged" />
            </Border>

            <!-- ── Start ── -->
            <Button Text="Start Game"
                    Clicked="OnStartClicked"
                    BackgroundColor="#C8963E"
                    TextColor="#111111"
                    FontSize="16"
                    FontAttributes="Bold"
                    CornerRadius="14"
                    HeightRequest="54" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
