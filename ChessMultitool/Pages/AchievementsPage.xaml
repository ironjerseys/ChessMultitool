<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ChessMultitool.AchievementsPage"
             BackgroundColor="#111111"
             Shell.NavBarIsVisible="False"
             Title="Achievements">

    <Grid RowDefinitions="Auto,*" RowSpacing="0">

        <!-- ── Header ── -->
        <Grid Grid.Row="0" Padding="20,52,20,12" ColumnDefinitions="*,Auto,*">
            <Border Grid.Column="0"
                    BackgroundColor="#1E1E1E"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 20"
                    Padding="13,8"
                    HorizontalOptions="Start"
                    VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackClicked" />
                </Border.GestureRecognizers>
                <Label Text="←" FontSize="14" FontAttributes="Bold" TextColor="#CCCCCC" VerticalTextAlignment="Center" />
            </Border>

            <Label Grid.Column="1"
                   Text="ACHIEVEMENTS"
                   FontSize="13"
                   FontAttributes="Bold"
                   CharacterSpacing="3"
                   TextColor="#555555"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,8,20,24" Spacing="0">

                <Label Text="Milestones"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="#EEEEEE" />
                <Label Text="Badges you unlock by beating the engine."
                       FontSize="13"
                       TextColor="#777777"
                       Margin="0,4,0,28" />

                <!-- ── Quick wins vs AI ── -->
                <Label Text="QUICK WINS VS AI"
                       FontSize="10"
                       FontAttributes="Bold"
                       CharacterSpacing="2"
                       TextColor="#444444"
                       Margin="0,0,0,12" />

                <CollectionView x:Name="QuickWinsList" Margin="0,0,0,28">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="2"
                                         HorizontalItemSpacing="10" VerticalItemSpacing="10" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="#1A1A1A"
                                    StrokeThickness="1.5"
                                    Stroke="Transparent"
                                    StrokeShape="RoundRectangle 14"
                                    Padding="12,16">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding Achieved}" Value="True">
                                        <Setter Property="Stroke" Value="#C8963E" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="★"
                                           FontSize="22"
                                           TextColor="#333333"
                                           HorizontalTextAlignment="Center">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding Achieved}" Value="True">
                                                <Setter Property="TextColor" Value="#C8963E" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Label Text="{Binding Name}"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="#888888"
                                           HorizontalTextAlignment="Center">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding Achieved}" Value="True">
                                                <Setter Property="TextColor" Value="#EEEEEE" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- ── Openings ── -->
                <Label Text="WINS BY OPENING"
                       FontSize="10"
                       FontAttributes="Bold"
                       CharacterSpacing="2"
                       TextColor="#444444"
                       Margin="0,0,0,12" />

                <CollectionView x:Name="WithList">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="2"
                                         HorizontalItemSpacing="10" VerticalItemSpacing="10" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="#1A1A1A"
                                    StrokeThickness="1.5"
                                    Stroke="Transparent"
                                    StrokeShape="RoundRectangle 14"
                                    Padding="12,16">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding Achieved}" Value="True">
                                        <Setter Property="Stroke" Value="#C8963E" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="♞"
                                           FontSize="22"
                                           TextColor="#333333"
                                           HorizontalTextAlignment="Center">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding Achieved}" Value="True">
                                                <Setter Property="TextColor" Value="#C8963E" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Label Text="{Binding Name}"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="#888888"
                                           HorizontalTextAlignment="Center">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding Achieved}" Value="True">
                                                <Setter Property="TextColor" Value="#EEEEEE" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
